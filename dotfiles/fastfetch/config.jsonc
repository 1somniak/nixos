{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/louis/.config/fastfetch/logo.txt"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "terminal",
    "wm",
    "icons",
    "font",
    "cursor",
    "terminalfont",
    "sound",
    "processes",
    "swap",
    "locale",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "width": 3,
        "range": [0, 15]
      }
    }
  ]
}